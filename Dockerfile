# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM docker.io/golang:1.27.3 AS server-builder
WORKDIR /workspace
ARG TARGETOS
ARG TARGETARCH
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY cmd/server ./cmd/server
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags='-s -w' -o /out/llm-server ./cmd/server

# Stable release and multi-architecture index shared with Embedding.
FROM ollama/ollama:0.40.4@sha256:926d40fd6eeeebd346b5c358a63de2a10ec995371cd93dd22f1843200694b1a6
ENV LLM_MODEL=gemma3:4b \
    LLM_MAX_PROMPT_TOKENS=3000 \
    OLLAMA_MODELS=/models \
    OLLAMA_HOST=127.0.0.1:11434 \
    HOME=/home/nonroot
# Pull at image build time; runtime never needs to download a model. Do not
# distribute the temporary Ollama identity generated by the build's daemon.
RUN set -eu; \
    export HOME=/tmp/ollama-build; \
    ollama serve & server=$!; \
    trap 'kill "$server" 2>/dev/null || true; wait "$server" 2>/dev/null || true' EXIT; \
    attempts=0; \
    until ollama list >/dev/null 2>&1; do \
        kill -0 "$server"; \
        attempts=$((attempts + 1)); \
        test "$attempts" -lt 120; \
        sleep 1; \
    done; \
    ollama pull "$LLM_MODEL"; \
    kill "$server"; \
    wait "$server" || true; \
    trap - EXIT; \
    rm -rf /tmp/ollama-build; \
    mkdir -p /home/nonroot; \
    chown -R 65532:65532 /home/nonroot; \
    chmod -R a+rX,a-w /models
COPY --from=server-builder /out/llm-server /llm-server
USER 65532
EXPOSE 8080
ENTRYPOINT ["/llm-server"]
